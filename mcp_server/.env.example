# Required — used by the analysis and synthesis tools
OPENAI_API_KEY=sk-your-key-here

# Optional — chat model used for analysis and synthesis (default: gpt-5.4)
# OPENAI_MODEL=gpt-5.4

# Optional but recommended — the unauthenticated Semantic Scholar pool is
# heavily rate-limited. Request a free key at
# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
